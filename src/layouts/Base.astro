---
import Email from '../components/Email.astro';
import { shareImageUrl } from '../lib/shareImage';
import '../styles/global.css';

const { title, description = 'Die Austauschplattform für Indonesier, Schweizer und alle Interessierten', image, type = 'website', jsonLd } = Astro.props;
const siteName = 'Verein Indonesia Schweiz';
const fullTitle = title && title !== siteName ? `${title} – ${siteName}` : siteName;
// Always the real domain, so the *.pages.dev copy doesn't compete in search
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = await shareImageUrl(image, Astro.site!);
const nav = [
  { href: '/events/', label: 'Events' },
  { href: '/ueber-uns/', label: 'Über uns' },
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replaceAll('<', '\\u003c')} />}
    <link rel="icon" href="/images/logos/cropped-Logo-Verein-Indonesia-Schweiz-32x32.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="border-t-4 border-merah-600 border-b border-b-mori-200 bg-mori-50">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3">
        <a class="flex items-center gap-3 font-serif text-lg font-bold text-soga-900 no-underline" href="/">
          <img src="/images/logos/Logo-Verein-Indonesia-Schweiz.png" alt="" width="40" height="40" />
          Verein Indonesia Schweiz
        </a>
        <nav aria-label="Hauptnavigation" class="flex flex-wrap items-center gap-5">
          {
            nav.map((n) => (
              <a
                href={n.href}
                aria-current={path.startsWith(n.href) ? 'page' : undefined}
                class="border-b-2 border-transparent py-1 text-soga-900 no-underline hover:border-merah-600 aria-[current=page]:border-merah-600"
              >
                {n.label}
              </a>
            ))
          }
          <a
            href="/mitgliedschaft/"
            aria-current={path.startsWith('/mitgliedschaft/') ? 'page' : undefined}
            class="rounded-full bg-merah-600 px-4 py-1.5 text-sm font-semibold text-white no-underline hover:bg-merah-700"
          >
            Mitglied werden
          </a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-nila-900 text-mori-100">
      <div class="bg-kawung h-4 bg-soga-900" aria-hidden="true"></div>
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 text-sm sm:grid-cols-3">
        <div>
          <h2 class="mb-2 text-base font-semibold text-prada-400">Kontakt</h2>
          <p class="[&_a]:text-white"><Email /></p>
          <p class="mt-2"><a class="text-white" href="https://www.facebook.com/groups/94359495038" rel="noopener">Facebook-Gruppe</a></p>
        </div>
        <div>
          <h2 class="mb-2 text-base font-semibold text-prada-400">Spenden</h2>
          <p>Verein Indonesia-Schweiz<br />Migros Bank AG<br />Kontonummer: 80-533-6<br />IBAN: CH91 0840 1000 0561 0910 5</p>
        </div>
        <div>
          <h2 class="mb-2 text-base font-semibold text-prada-400">Mitgliederbeiträge</h2>
          <p>Verein Indonesia-Schweiz<br />Post Finance AG, 4808 Zofingen<br />Kontonummer: 80-37981-2<br />IBAN: CH39 0900 0000 8003 7981 2<br />BIC: POFICHBEXXX</p>
        </div>
      </div>
      <p class="mx-auto max-w-6xl px-4 pb-6 text-xs text-mori-200/70">© {new Date().getFullYear()} Verein Indonesia Schweiz</p>
    </footer>
  </body>
</html>
