---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  // "home" is rendered by index.astro
  const pages = await getCollection('pages', (p) => p.id !== 'home');
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<Base title={page.data.title} description={page.data.summary} image={page.data.image}>
  <article class="wrap section prose">
    <h1>{page.data.title}</h1>
    <Content />
  </article>
</Base>
