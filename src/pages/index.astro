---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import EventRow from '../components/EventRow.astro';
import { splitEvents, formatEventDate } from '../lib/events.js';
import { orgJsonLd } from '../lib/seo.js';

const home = await getEntry('pages', 'home');
const { Content } = await render(home);
const { upcoming, past } = splitEvents(await getCollection('events'));
const [next, ...later] = upcoming;
---

<Base title={home.data.title} description={home.data.summary} image={home.data.image} jsonLd={orgJsonLd(home.data.summary)}>
  {
    next ? (
      /* Poster hero: the next event is the star */
      <section class="relative overflow-hidden bg-soga-900 text-mori-50">
        <div class="bg-kawung absolute inset-0 opacity-30" aria-hidden="true" />
        <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 lg:grid-cols-[1.2fr_1fr] lg:py-24">
          <div>
            <p class="text-sm font-semibold tracking-[0.2em] text-prada-400 uppercase">Nächster Event</p>
            <h1 class="mt-3 text-4xl font-bold text-mori-50 sm:text-6xl">{next.data.title}</h1>
            <p class="mt-5 text-lg font-semibold">
              {formatEventDate(next.data)}
              {next.data.time && ` · ${next.data.time}`}
            </p>
            {next.data.location && <p class="text-mori-200">{next.data.location}</p>}
            {next.data.summary && <p class="mt-5 max-w-xl text-mori-100">{next.data.summary}</p>}
            <a href={`/events/${next.id}/`} class="mt-8 inline-block rounded-full bg-merah-600 px-6 py-3 font-semibold text-white no-underline hover:bg-merah-700">
              Details &amp; Programm
            </a>
          </div>
          {next.data.image && (
            <a href={`/events/${next.id}/`} class="mx-auto block w-full max-w-sm">
              <Image
                src={next.data.image}
                alt={`Flyer: ${next.data.title}`}
                widths={[400, 800]}
                sizes="(min-width: 1024px) 384px, 90vw"
                loading="eager"
                fetchpriority="high"
                class="w-full rotate-2 rounded-lg shadow-2xl ring-8 ring-mori-50 transition duration-300 hover:rotate-0"
              />
            </a>
          )}
        </div>
      </section>
    ) : (
      /* No event planned: welcome hero with the photo in a gapura (gate) arch */
      <section class="overflow-hidden bg-mori-100">
        <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 lg:grid-cols-2 lg:py-24">
          <div>
            <p class="text-sm font-semibold tracking-[0.2em] text-prada-700 uppercase">Selamat datang · Willkommen</p>
            <h1 class="mt-3 text-5xl font-bold sm:text-7xl">{home.data.title}</h1>
            {home.data.summary && <p class="mt-5 text-xl text-soga-700">{home.data.summary}</p>}
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="/events/" class="rounded-full bg-merah-600 px-6 py-3 font-semibold text-white no-underline hover:bg-merah-700">Events &amp; Rückblick</a>
              <a href="/mitgliedschaft/" class="rounded-full border-2 border-soga-900 px-6 py-3 font-semibold text-soga-900 no-underline hover:bg-soga-900 hover:text-mori-50">Mitglied werden</a>
            </div>
            <p class="mt-6 text-sm text-soga-500">Zurzeit sind keine Events geplant – neue Anlässe werden hier angekündigt.</p>
          </div>
          {home.data.image && (
            <div class="relative mx-auto w-full max-w-md">
              <div class="bg-kawung absolute -inset-3 rounded-t-full bg-soga-700" aria-hidden="true" />
              <Image
                src={home.data.image}
                alt=""
                widths={[500, 1000]}
                sizes="(min-width: 1024px) 448px, 90vw"
                loading="eager"
                fetchpriority="high"
                class="relative aspect-4/5 w-full rounded-t-full object-cover"
              />
            </div>
          )}
        </div>
      </section>
    )
  }

  {
    later.length > 0 && (
      <section class="mx-auto max-w-4xl px-4 py-14">
        <h2 class="mb-4 text-3xl font-bold">Weitere Termine</h2>
        <div class="divide-y divide-mori-200">{later.map((e) => <EventRow event={e} />)}</div>
      </section>
    )
  }

  <section class="mx-auto grid max-w-6xl items-start gap-10 px-4 py-16 lg:grid-cols-[1fr_2fr]">
    <div class="bg-kawung hidden aspect-square place-items-center rounded-2xl bg-soga-900 lg:grid" aria-hidden="true">
      <img src="/images/logos/Logo-Verein-Indonesia-Schweiz.png" alt="" width="140" height="140" class="rounded-full bg-mori-50 p-4 shadow-lg" />
    </div>
    <div class="prose prose-lg prose-stone prose-headings:font-serif prose-a:text-merah-600">
      <Content />
    </div>
  </section>

  {
    past.length > 0 && (
      <section class="border-y border-mori-200 bg-mori-100 py-14">
        <div class="mx-auto flex max-w-6xl items-end justify-between gap-4 px-4">
          <h2 class="text-3xl font-bold">Rückblick</h2>
          <a class="font-semibold text-merah-600" href="/events/">Alle Events →</a>
        </div>
        <div class="mx-auto mt-6 flex max-w-6xl snap-x snap-mandatory gap-5 overflow-x-auto px-4 pb-4">
          {past.map((e) => (
            <a href={`/events/${e.id}/`} class="group relative w-56 shrink-0 snap-start overflow-hidden rounded-xl no-underline shadow-sm">
              {e.data.image ? (
                <Image src={e.data.image} alt={`Flyer: ${e.data.title}`} width={224} height={299} densities={[1, 2]} class="aspect-3/4 w-full object-cover transition duration-300 group-hover:scale-105" />
              ) : (
                <div class="bg-kawung aspect-3/4 w-full bg-soga-700" aria-hidden="true" />
              )}
              <div class="absolute inset-x-0 bottom-0 bg-linear-to-t from-soga-900/95 to-transparent p-4 pt-12 text-mori-50">
                <p class="text-xs font-semibold tracking-widest text-prada-400">{e.data.eventDate.getUTCFullYear()}</p>
                <p class="font-serif text-lg leading-tight font-bold">{e.data.title}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section class="relative overflow-hidden bg-merah-700 text-white">
    <div class="bg-kawung absolute inset-0 opacity-25" aria-hidden="true"></div>
    <div class="relative mx-auto flex max-w-6xl flex-col items-start justify-between gap-6 px-4 py-14 sm:flex-row sm:items-center">
      <div>
        <h2 class="text-3xl font-bold text-white">Mitglied werden</h2>
        <p class="mt-2 max-w-xl text-mori-100">Unterstützen Sie indonesische Kultur in der Schweiz und karitative Projekte in Indonesien.</p>
      </div>
      <a href="/mitgliedschaft/" class="shrink-0 rounded-full bg-mori-50 px-6 py-3 font-semibold text-merah-700 no-underline hover:bg-white">Mehr erfahren</a>
    </div>
  </section>
</Base>
