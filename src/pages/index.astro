---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import { splitEvents } from '../lib/events.js';
import { orgJsonLd } from '../lib/seo.js';

const home = await getEntry('pages', 'home');
const { Content } = await render(home);
const { upcoming, past } = splitEvents(await getCollection('events'));
---

<Base title={home.data.title} description={home.data.summary} image={home.data.image} jsonLd={orgJsonLd(home.data.summary)}>
  <section class="relative isolate overflow-hidden bg-soga-900 text-center text-mori-50">
    {
      home.data.image && (
        <Image
          src={home.data.image}
          alt=""
          widths={[800, 1600, 2400]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 -z-10 h-full w-full object-cover opacity-45"
        />
      )
    }
    <div class="mx-auto max-w-6xl px-4 py-24 sm:py-36">
      <h1 class="text-4xl font-bold text-mori-50 sm:text-6xl">{home.data.title}</h1>
      {home.data.summary && <p class="mt-4 text-lg sm:text-xl">{home.data.summary}</p>}
      <a href="/events/" class="mt-8 inline-block rounded-full bg-merah-600 px-6 py-3 font-semibold text-white no-underline hover:bg-merah-700">Zu den Events</a>
    </div>
  </section>
  <div class="bg-kawung h-4 bg-soga-700" aria-hidden="true"></div>

  <section class="mx-auto max-w-6xl px-4 py-12">
    <h2 class="mb-6 text-3xl font-bold">Nächste Events</h2>
    {
      upcoming.length ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{upcoming.map((e) => <EventCard event={e} />)}</div>
      ) : (
        <p class="rounded-xl border border-dashed border-soga-300 bg-mori-100 p-6 text-soga-700">
          Zurzeit sind keine Events geplant – schauen Sie bald wieder vorbei.
        </p>
      )
    }
  </section>

  <section class="bg-mori-100">
    <div class="prose prose-stone prose-headings:font-serif prose-a:text-merah-600 mx-auto max-w-3xl px-4 py-12">
      <Content />
    </div>
  </section>

  {
    past.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-12">
        <h2 class="mb-6 text-3xl font-bold">Vergangene Events</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{past.slice(0, 3).map((e) => <EventCard event={e} />)}</div>
        <p class="mt-6"><a class="font-semibold text-merah-600" href="/events/">Alle Events →</a></p>
      </section>
    )
  }
</Base>
