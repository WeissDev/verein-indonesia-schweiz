---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import DateBlock from '../../components/DateBlock.astro';
import { formatEventDate } from '../../lib/events.js';
import { eventJsonLd } from '../../lib/seo.js';
import { shareImageUrl } from '../../lib/shareImage';

export async function getStaticPaths() {
  const events = await getCollection('events', (e) => !e.data.draft);
  return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}

const { event } = Astro.props;
const { title, eventDate, time, location, image, summary } = event.data;
const { Content } = await render(event);
const url = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = eventJsonLd(event.data, { url, image: image && (await shareImageUrl(image, Astro.site!)) });
const mapsUrl = location && `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(location)}`;
---

<Base
  title={title}
  description={summary ?? `${formatEventDate(event.data)}${location ? `, ${location}` : ''}`}
  image={image}
  type="article"
  jsonLd={jsonLd}
>
  <PageHeader title={title} eyebrow="Event">
    {summary && <p class="mt-4 max-w-2xl text-lg text-mori-200">{summary}</p>}
  </PageHeader>

  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 lg:grid-cols-[1fr_20rem]">
    <aside class="lg:order-2">
      <div class="space-y-5 rounded-2xl border border-mori-200 bg-white p-6 shadow-sm lg:sticky lg:top-6">
        <DateBlock date={eventDate} size="lg" />
        <dl class="space-y-3 text-sm">
          <div><dt class="font-semibold tracking-wide text-prada-700 uppercase">Datum</dt><dd>{formatEventDate(event.data)}</dd></div>
          {time && <div><dt class="font-semibold tracking-wide text-prada-700 uppercase">Zeit</dt><dd>{time}</dd></div>}
          {location && <div><dt class="font-semibold tracking-wide text-prada-700 uppercase">Ort</dt><dd>{location}</dd></div>}
        </dl>
        {mapsUrl && <a href={mapsUrl} target="_blank" rel="noopener" class="block rounded-full bg-merah-600 px-5 py-2.5 text-center font-semibold text-white no-underline hover:bg-merah-700">Route planen ↗</a>}
        <a href="/events/" class="block text-center text-sm font-semibold text-merah-600">← Alle Events</a>
      </div>
    </aside>

    <article class="min-w-0">
      {
        image && (
          <Image
            class="mb-10 max-h-[85vh] w-auto rounded-xl shadow-lg"
            src={image}
            alt={`Flyer ${title}`}
            widths={[600, 1200]}
            sizes="(min-width: 1024px) 720px, 100vw"
            loading="eager"
          />
        )
      }
      <div class="prose prose-stone prose-headings:font-serif prose-a:text-merah-600 prose-img:rounded-xl">
        <Content />
      </div>
    </article>
  </div>
</Base>
