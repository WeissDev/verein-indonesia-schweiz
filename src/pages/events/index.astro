---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EventCard from '../../components/EventCard.astro';
import { splitEvents } from '../../lib/events.js';

const { upcoming, past } = splitEvents(await getCollection('events'));
const pastByYear = Object.entries(Object.groupBy(past, (e) => String(e.data.eventDate.getUTCFullYear()))).sort(([a], [b]) => Number(b) - Number(a));
---

<Base title="Events">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="mb-8 text-4xl font-bold">Events</h1>

    <h2 class="mb-4 text-2xl font-bold">Demnächst</h2>
    {
      upcoming.length ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{upcoming.map((e) => <EventCard event={e} />)}</div>
      ) : (
        <p class="text-soga-500">Zurzeit sind keine Events geplant.</p>
      )
    }

    {
      pastByYear.map(([year, events]) => (
        <>
          <h2 class="mt-12 mb-4 border-b border-mori-200 pb-2 text-2xl font-bold">{year}</h2>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{events.map((e) => <EventCard event={e} />)}</div>
        </>
      ))
    }
  </div>
</Base>
