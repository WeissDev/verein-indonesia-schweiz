---
// Anti-scraping: the address never appears whole in the HTML (not even encoded). Name and domain
// are stored reversed in separate attributes and only joined after a real click.
const { addr = 'info', domain = 'vereinindonesiaschweiz.ch', label = 'E-Mail-Adresse anzeigen' } = Astro.props;
const rev = (s: string) => [...s].reverse().join('');
---

<button type="button" class="email-reveal cursor-pointer underline decoration-dotted underline-offset-4" data-u={rev(addr)} data-d={rev(domain)}>
  {label}
</button>

<script>
  const rev = (s: string) => [...s].reverse().join('');
  document.querySelectorAll<HTMLButtonElement>('.email-reveal').forEach((btn) => {
    btn.addEventListener('click', () => {
      const address = `${rev(btn.dataset.u!)}@${rev(btn.dataset.d!)}`;
      const link = document.createElement('a');
      link.href = `mailto:${address}`;
      link.textContent = address;
      btn.replaceWith(link);
      link.focus();
    });
  });
</script>
